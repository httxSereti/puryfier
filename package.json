{
  "name": "puryfier",
  "version": "0.3.0",
  "private": true,
  "description": "Puryfier - Puryfi & Chaster extension",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "generate:api": "pnpm --filter server openapi && pnpm --filter front generate:api",
    "check:api": "pnpm --filter server check:openapi && pnpm --filter front check:api",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=11"
  }
}
