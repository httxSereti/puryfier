{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["front/.env", "server/.env"],
  "globalEnv": [
    "VITE_BACKEND_URL",
    "VITE_PURYFI_WS_URL",
    "VITE_APP_VERSION"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_NAME",
    "CHASTER_DEVELOPER_TOKEN",
    "CHASTER_WEBHOOK_USER",
    "CHASTER_WEBHOOK_PWD",
    "FRONT_URL",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ACCOUNT_ID",
    "WRANGLER_*",
    "UV_*",
    "NODE_OPTIONS"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
