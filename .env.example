# How to expose the app:
#   tunnel  -> Cloudflare Tunnel (recommended, no inbound port, no certificate)
#   traefik -> Traefik + Let's Encrypt (self-hosting with ports 80/443)
COMPOSE_PROFILES=tunnel

# Single public domain. The frontend, /api and /ws are all served from it.
# It must be a domain managed by Cloudflare.
PUBLIC_DOMAIN=app.example.com

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (COMPOSE_PROFILES=tunnel)
# ---------------------------------------------------------------------------
# Zero Trust > Networks > Tunnels > Create a tunnel > Cloudflared
# Add ONE public hostname:
#   app.example.com -> http://front:80
CLOUDFLARE_TUNNEL_TOKEN=

# get it here; https://chaster.app/developers/applications
CHASTER_DEVELOPER_TOKEN=

# webhook username
CHASTER_WEBHOOK_USER=WH_USER

# webhook password
CHASTER_WEBHOOK_PWD=WH_PASSWORD

# mongodb database url (local development; Docker Compose connects the
# server container to the `mongo` service automatically)
DATABASE_URL=mongodb://puryfi:puryfi@localhost:27017/puryfi_chaster?authSource=admin

# ---------------------------------------------------------------------------
# Traefik mode only (COMPOSE_PROFILES=traefik)
# ---------------------------------------------------------------------------
# Acme email for DNS
ACME_EMAIL=you@example.com

# CF DNS API token (Zone / DNS / Edit + Zone / Zone / Read)
CF_DNS_API_TOKEN=your_cloudflare_token
