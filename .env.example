# get it here; https://chaster.app/developers/applications
CHASTER_DEVELOPER_TOKEN=

# webhook username
CHASTER_WEBHOOK_USER=WH_USER

# webhook password
CHASTER_WEBHOOK_PWD=WH_PASSWORD

# mongodb database url
DATABASE_URL=mongodb://puryfi:puryfi@mongo:27017/puryfi_chaster?authSource=admin

# Acme email for DNS
ACME_EMAIL=you@example.com

# CF DNS API
CF_DNS_API_TOKEN=your_cloudflare_token

# Front domain
FRONT_DOMAIN=app.example.com

# frontend url
FRONT_URL=https://app.example.com

# API domain
API_DOMAIN=api.example.com

# Backend url
BACKEND_URL=https://api.example.com

# Puryfi WS Url
WEBSOCKET_URL=wss://api.example.com