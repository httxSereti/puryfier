{
  "name": "server",
  "version": "0.3.0",
  "private": true,
  "description": "Puryfier Python backend",
  "scripts": {
    "dev": "uv run uvicorn main:app --app-dir src --reload --reload-dir src --host 0.0.0.0 --port 8000 --ws-ping-interval 20 --ws-ping-timeout 20",
    "start": "uv run uvicorn main:app --app-dir src --host 0.0.0.0 --port 8000 --ws-ping-interval 20 --ws-ping-timeout 20",
    "openapi": "uv run python scripts/export_openapi.py",
    "check:openapi": "uv run python scripts/export_openapi.py --check",
    "lint": "uv run ruff check .",
    "test": "uv run pytest"
  }
}
