CHASTER_DEVELOPER_TOKEN=

# Required and must be non-empty: the server refuses to start otherwise.
CHASTER_WEBHOOK_USER=
CHASTER_WEBHOOK_PWD=

# MongoDB
DATABASE_URL=mongodb://puryfi:puryfi@localhost:27017/puryfi_chaster?authSource=admin
# Optional: overrides the database name found in DATABASE_URL.
DATABASE_NAME=

# Public frontend origin allowed by CORS (no trailing slash).
FRONT_URL=http://localhost:5173

# Logging: json for production log collectors, console for development.
# Leave LOG_FORMAT empty to auto-detect (console on a TTY, json otherwise).
LOG_LEVEL=INFO
LOG_FORMAT=
